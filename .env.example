# Central SentinelX configuration. Keep the real file private (chmod 600).
DATABASE_URL=sqlite:///./sentinelx.db
SENTINELX_ADMIN_USERNAME=admin
SENTINELX_ADMIN_PASSWORD=replace-with-a-long-unique-password
SENTINELX_SESSION_HOURS=12
SENTINELX_COOKIE_SECURE=true

# Agent enrollment is created by an authenticated administrator in the dashboard/API.
# Set this only on a new agent for its first enrollment; remove it after enrollment.
SENTINELX_URL=https://sentinelx.internal
SENTINELX_ENROLLMENT_TOKEN=paste-one-time-enrollment-token
SENTINELX_HOST_ID=unique-host-id
SENTINELX_INTERVAL=30
SENTINELX_WATCH_PATHS=/etc,/opt,/var/www,/home

# Temporary migration only. Keep false; the legacy shared token is disabled by default.
SENTINELX_ALLOW_LEGACY_AGENT_TOKEN=false
